# Mode « tunnel » : HTTPS est assuré par Cloudflare ; Caddy n'écoute qu'en HTTP dans le réseau Docker.
{
  auto_https off
}
:80 {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    -Server
  }
  # L'API (aussi appelée directement par l'app mobile) ; tout le reste est l'interface web.
  # /actuator et la documentation OpenAPI ne sont jamais exposés.
  handle /api/v1/* {
    request_body {
      max_size 12MB
    }
    reverse_proxy app:8080
  }
  handle {
    reverse_proxy web:3000
  }
}
